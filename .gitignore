# macOS
.DS_Store

# Xcode — build products and derived data
build/
DerivedData/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
*.xcresult

# Python — bytecode from the Tools/ scripts
__pycache__/
*.pyc

# Xcode — per-user state (schemes live in xcshareddata instead)
xcuserdata/

# Swift Package Manager
.build/
.swiftpm/
Packages/
Package.resolved

# Playgrounds
timeline.xctimeline
playground.xcworkspace

# App Store media — regenerated by Tools/appstore_media.sh, see
# AppStore/screenshots.md. Around 155 MB a run, and stale the moment the app
# looks different.
AppStore/screenshots/
AppStore/preview/

# Puzzle build inputs — Tools/build_puzzles.py streams the Lichess sample into
# dl/ (~250 MB) and builds its Swift validator in work/. Only the resulting
# chess/Puzzles/puzzles.csv belongs in the repository.
/dl/
/work/

# Claude Code — scratch worktrees and per-user settings
.claude/worktrees/
.claude/settings.local.json
