    "Discovered attack: you move one piece and the piece behind it starts attacking." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odkrytý útok: odtáhnete jednu figuru a začne útočit ta za ní."
