    "Get your pieces out" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyveďte figury"
          }
        }
      }
    },
    "Give your pieces work" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dejte figurám práci"
          }
        }
      }
    },
    "Good" : {
      "comment" : "Move grade",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dobrý"
          }
        }
      }
    },
    "Good moves usually improve a piece: a rook onto an open file, a knight to a square no pawn can chase it from, a bishop onto a long clear diagonal. If you have no plan, find your worst piece and make it better." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dobré tahy obvykle zlepšují nějakou figuru: věž na otevřený sloupec, jezdce na pole, odkud ho žádný pěšec nevyžene, střelce na dlouhou volnou diagonálu. Když nemáte plán, najděte svou nejhorší figuru a zlepšete ji."
          }
        }
      }
    },
    "grade.excellent" : {
      "comment" : "Move grade",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vynikající"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excellent"
          }
        }
      }
    },
    "Grandmaster" : {
