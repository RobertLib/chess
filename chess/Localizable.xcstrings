    "Chess" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šachy"
          }
        }
      }
    },
    "Chess · an offline game for one or two players" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šachy · offline hra pro jednoho i dva hráče"
          }
        }
      }
    },
    "Chess is a battle between White and Black on a board of eight columns and eight rows. White always makes the first move, and from then on the players take turns — one move each, no passing, no skipping." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šachy jsou bitva bílého a černého na desce o osmi sloupcích a osmi řadách. Bílý táhne vždy jako první a od té chvíle se hráči střídají — každý jeden tah, nedá se vynechat ani přeskočit."
          }
        }
      }
    },
    "Chessboard" : {
      "comment" : "VoiceOver name for the board",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šachovnice"
