    "First steps at the board" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "První kroky u šachovnice"
          }
        }
      }
    },
    "Five difficulty levels" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pět úrovní obtížnosti"
          }
        }
      }
    },
    "Five difficulty levels wait under Play vs Computer — the lowest ones play like a beginner on purpose." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pod Hrát proti počítači čeká pět úrovní obtížnosti — ty nejnižší hrají jako začátečník záměrně."
          }
        }
      }
    },
    "Flawless" : {
      "comment" : "Verdict on a player's accuracy",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez chyby"
          }
        }
