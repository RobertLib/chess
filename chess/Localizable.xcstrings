              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Last game · %lld moves"
                }
              }
            }
          }
        }
      }
    },
    "last move" : {
      "comment" : "VoiceOver value on the squares of the move just played",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "poslední tah"
          }
        }
      }
    },
    "Leave the queen at home for a while: she is easy to chase, and every check she has to run from costs you a move." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nechte dámu chvíli doma: snadno se žene a každý útok, před kterým musí utéct, vás stojí tah."
          }
        }
      }
    },
    "Lesson diagram" : {
      "comment" : "VoiceOver name for a board inside a lesson",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diagram lekce"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lesson diagram"
          }
        }
      }
    },
    "Level position" : {
      "comment" : "VoiceOver: neither side is better",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyrovnaná pozice"
          }
        }
      }
    },
    "London System" : {
      "comment" : "Chess opening",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
